datasource db {
    provider = "postgresql"    
    url      = env("DATABASE_URL")
}

generator client {
    provider = "prisma-client"
    output = "./generated"
}

model Project {
    id Int @id @default(autoincrement())   

    name String @unique @db.VarChar(200) 
    slug String @unique @db.VarChar(200) 
    description String @db.VarChar(500)
    content String @db.Text

    repoUrl String? @db.VarChar(255)
    liveUrl String? @db.VarChar(255)

    featured Boolean @default(false)

    categories Category[] 
    technologies Technology[] 
    

    status ProjectStatus 

    icon String? @db.VarChar(255)

    createdAt DateTime @default(now()) //TODO: generate this field using GitHub API
    updatedAt DateTime @updatedAt //TODO: Remove from database and generate this field using GitHub API

    @@map("projects")
}

model Category {
    id Int @id @default(autoincrement())

    name String @unique @db.VarChar(200) 
    slug String @unique @db.VarChar(200) 

    badgeTextColor String @db.VarChar(7) @default("#FFFFFF")
    badgeBackgroundColor String @db.VarChar(7) @default("#000000")

    projects Project[]

    @@map("categories")
}

model Technology {
    id Int @id @default(autoincrement())

    name String @unique @db.VarChar(200) 
    slug String @unique @db.VarChar(200) 

    badgeTextColor String @db.VarChar(7) @default("#FFFFFF")
    badgeBackgroundColor String @db.VarChar(7) @default("#000000")

    icon String? @db.VarChar(255)

    projects Project[]

    @@map("technologies")
}

enum ProjectStatus {
    IN_PROGRESS
    COMPLETED
    ON_HOLD

    @@map("project_statuses") 
}